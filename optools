#!/bin/bash

set -euo pipefail

LOG_FILE="${LOG_FILE:-run.log}"
PID_FILE="${PID_FILE:-.jekyll.pid}"
MIN_RUBY_VERSION="${MIN_RUBY_VERSION:-3.1.0}"
AUTO_FIX="${AUTO_FIX:-1}"
RBENV_RUBY_VERSION="${RBENV_RUBY_VERSION:-3.2.3}"
DEBUG="${DEBUG:-0}"

COMMAND="${1:-}"
APP_NAME="${APP_NAME:-jekyll}"
REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  ./optools start         Start Jekyll in background
  ./optools stop          Stop running Jekyll processes
  ./optools restart       Stop then start
  ./optools status        Show whether Jekyll is running
  ./optools check         Check Ruby/Bundler/Gems readiness (no start)
  ./optools ruby-check    Print Ruby/Bundler paths and versions only (diagnostics)
  ./optools ruby-upgrade  Install/upgrade Ruby via rbenv on Ubuntu, then bundler + bundle install
  ./optools shell-init    Append rbenv lines to ~/.bashrc (idempotent) so plain ruby/bundle use rbenv
  ./optools run -- CMD    Run CMD with rbenv on PATH (e.g. bundle exec …) without fixing ~/.bashrc
  ./optools liquid-check      Liquid-parse all _posts (tools/check_liquid_posts.rb); optional args after command
  ./optools bundle-content-css Regenerate _sass/_post-content-bundle.scss (tools/bundle-post-content-css.sh)
  ./optools help              Show this help

Env:
  LOG_FILE=run.log              Output log file
  PID_FILE=.jekyll.pid          PID file for the background process
  MIN_RUBY_VERSION=3.1.0        Minimum Ruby version
  AUTO_FIX=1                    Auto-fix Ruby via rbenv (Ubuntu) when too old (start/check)
  RBENV_RUBY_VERSION=3.2.3      Ruby version to install via rbenv / ruby-upgrade
  DEBUG=0                       Set to 1 to add jekyll --trace (for debugging Liquid/build errors)
EOF
  echo ""
  echo "Note: check / ruby-check / start load rbenv inside the script only. Your interactive shell"
  echo "still uses system ruby until:  ./optools shell-init && source ~/.bashrc"
  echo "Or:  ./optools liquid-check   (same checker; supports --verbose, --encoding-report)"
  echo ""
  echo "For Jekyll/Liquid errors, run with trace:  DEBUG=1 ./optools start"
  echo "Then check run.log or:  tail -f run.log"
  echo ""
  echo "If 'bundle' fails with GemNotFoundException for bundler:  ./optools ruby-upgrade"
  echo "  (or: gem install bundler && bundle install)  using the same Ruby as: which ruby"
}

run_cmd() {
  echo "[run] $*"
  "$@"
}

maybe_sudo() {
  if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    "$@"
  else
    sudo "$@"
  fi
}

stop_jekyll() {
  if [ -f "${PID_FILE}" ]; then
    local pid
    pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    if [ -n "${pid}" ] && kill -0 "${pid}" >/dev/null 2>&1; then
      echo "[run] stopping ${APP_NAME} (pid ${pid})..."
      kill "${pid}" || true
      sleep 1
      if kill -0 "${pid}" >/dev/null 2>&1; then
        echo "[run] WARNING: still running, forcing stop..."
        kill -9 "${pid}" || true
      fi
      rm -f "${PID_FILE}" || true
      return 0
    fi
    rm -f "${PID_FILE}" || true
  fi

  if pgrep -f "jekyll serve" >/dev/null 2>&1; then
    echo "[run] stopping ${APP_NAME}..."
    pkill -f "jekyll serve" || true
    sleep 1
  fi

  if pgrep -f "jekyll serve" >/dev/null 2>&1; then
    echo "[run] WARNING: still running, forcing stop..."
    pkill -9 -f "jekyll serve" || true
  fi
}

status_jekyll() {
  if [ -f "${PID_FILE}" ]; then
    local pid
    pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    if [ -n "${pid}" ] && kill -0 "${pid}" >/dev/null 2>&1; then
      echo "[run] status: running (pid ${pid})"
      return 0
    fi
  fi

  if pgrep -f "jekyll serve" >/dev/null 2>&1; then
    echo "[run] status: running"
    pgrep -af "jekyll serve" || true
    return 0
  fi
  echo "[run] status: stopped"
  if [ -f "${LOG_FILE}" ]; then
    echo "[run] ---- last 50 lines of ${LOG_FILE} ----"
    tail -n 50 "${LOG_FILE}" || true
  fi
  return 1
}

ensure_rbenv_loaded() {
  export RBENV_ROOT="${RBENV_ROOT:-$HOME/.rbenv}"
  export PATH="$RBENV_ROOT/bin:$PATH"

  if command -v rbenv >/dev/null 2>&1; then
    # shellcheck disable=SC1090
    eval "$(rbenv init - bash)"
    return 0
  fi

  return 1
}

# Non-login shells (e.g. SSH then ./optools) often lack rbenv in PATH; system Ruby stays first.
# Call this before any ruby/bundle use so ~/.rbenv wins when present.
prefer_rbenv_if_present() {
  export RBENV_ROOT="${RBENV_ROOT:-$HOME/.rbenv}"
  if [ ! -x "${RBENV_ROOT}/bin/rbenv" ]; then
    return 0
  fi
  export PATH="${RBENV_ROOT}/bin:${PATH}"
  # shellcheck disable=SC1090
  eval "$(rbenv init - bash)"
  return 0
}

RBENV_BASHRC_MARKER="# awesome-share optools: rbenv"

# Idempotently append rbenv init to ~/.bashrc so plain `ruby` / `bundle` match rbenv shims.
install_rbenv_into_bashrc() {
  local rc="${HOME}/.bashrc"
  if [ ! -x "${RBENV_ROOT:-$HOME/.rbenv}/bin/rbenv" ]; then
    echo "[run] shell-init skipped: ${RBENV_ROOT:-$HOME/.rbenv}/bin/rbenv not found"
    return 1
  fi

  if [ ! -f "$rc" ]; then
    touch "$rc" || return 1
  fi

  if grep -qF "$RBENV_BASHRC_MARKER" "$rc" 2>/dev/null; then
    echo "[run] rbenv block already in ${rc} (marker: ${RBENV_BASHRC_MARKER})"
    return 0
  fi

  cat >>"$rc" <<RBENVEOF

${RBENV_BASHRC_MARKER}
export PATH="\$HOME/.rbenv/bin:\$PATH"
eval "\$(rbenv init - bash)"
RBENVEOF

  echo "[run] appended rbenv initialization to ${rc}"
  echo "[run] run:  source ~/.bashrc   (or open a new SSH session), then:  which ruby"
  return 0
}

ruby_check_warn_interactive_path() {
  if [ ! -x "${RBENV_ROOT:-$HOME/.rbenv}/bin/rbenv" ]; then
    return 0
  fi
  if grep -qF "$RBENV_BASHRC_MARKER" "${HOME}/.bashrc" 2>/dev/null; then
    return 0
  fi
  echo "[run] NOTE: this shell may still use /usr/bin/ruby until:  ./optools shell-init && source ~/.bashrc"
  echo "[run]       or run tools via:  ./optools run -- bundle exec …"
}

# Print diagnostic lines; does not modify the system.
ruby_check_diagnostics() {
  echo "[run] --- Ruby / Bundler diagnostics ---"
  if command -v ruby >/dev/null 2>&1; then
    echo "[run] which ruby:    $(command -v ruby)"
    echo "[run] ruby -v:       $(ruby -v 2>&1)"
    echo "[run] ruby version:  $(ruby -e 'print RUBY_VERSION' 2>&1)"
  else
    echo "[run] ruby:          (not found in PATH)"
  fi

  if command -v bundle >/dev/null 2>&1; then
    echo "[run] which bundle:  $(command -v bundle)"
    if out="$(bundle -v 2>&1)"; then
      echo "[run] bundle -v:     ${out}"
    else
      echo "[run] bundle -v:     FAILED — ${out}"
      echo "[run] hint: often 'can't find gem bundler' means this bundle stub belongs to another Ruby."
      echo "[run]        Run:  gem install bundler   (same shell as: which ruby)"
    fi
  else
    echo "[run] bundle:        (not found in PATH)"
  fi

  if command -v rbenv >/dev/null 2>&1; then
    echo "[run] rbenv:         $(command -v rbenv)"
    rbenv version 2>/dev/null || true
  else
    echo "[run] rbenv:         (not in PATH; optional)"
  fi
  echo "[run] required:      Ruby >= ${MIN_RUBY_VERSION} (Chirpy / Jekyll 4.3)"
  echo "[run] ---"
}

ruby_version_ok() {
  local ver
  ver="$(ruby -e 'print RUBY_VERSION' 2>/dev/null)" || return 1
  printf '%s\n%s\n' "$MIN_RUBY_VERSION" "$ver" | sort -V -C
}

# Ensure Bundler works for the current ruby; fixes broken `bundle` stubs.
ensure_bundler() {
  if ! command -v ruby >/dev/null 2>&1; then
    return 1
  fi

  if ! command -v bundle >/dev/null 2>&1; then
    echo "[run] bundler not in PATH; installing..."
    gem install bundler --no-document
    return 0
  fi

  if ! bundle -v >/dev/null 2>&1; then
    echo "[run] 'bundle' exists but does not run; reinstalling bundler for current Ruby..."
    gem install bundler --no-document
  fi

  return 0
}

# Exit 0 if Ruby and bundle -v OK; 1 otherwise. Optional: bundle check.
cmd_ruby_check() {
  prefer_rbenv_if_present
  ruby_check_diagnostics

  if ! command -v ruby >/dev/null 2>&1; then
    echo "[run] ERROR: ruby not found"
    return 1
  fi

  if ! ruby_version_ok; then
    echo "[run] ERROR: Ruby $(ruby -e 'print RUBY_VERSION') is older than required ${MIN_RUBY_VERSION}"
    echo "[run] On Ubuntu:  AUTO_FIX=1 ./optools ruby-upgrade   or see: ./optools help"
    return 1
  fi

  if ! command -v bundle >/dev/null 2>&1 || ! bundle -v >/dev/null 2>&1; then
    echo "[run] ERROR: Bundler missing or broken for this Ruby"
    echo "[run] Try:  gem install bundler && bundle -v"
    return 1
  fi

  if bundle check >/dev/null 2>&1; then
    echo "[run] bundle check:  OK"
  else
    echo "[run] bundle check:  gems missing — run:  bundle install"
    return 1
  fi

  echo "[run] ruby-check: OK"
  ruby_check_warn_interactive_path
  return 0
}

# Install Ruby via rbenv (Ubuntu) and bundler + project gems.
cmd_ruby_upgrade() {
  if [ "$AUTO_FIX" != "1" ]; then
    echo "[run] ruby-upgrade requires AUTO_FIX=1 (default). To run upgrades, use:"
    echo "  AUTO_FIX=1 ./optools ruby-upgrade"
    echo "Or set AUTO_FIX=0 only when you want to block any install attempts."
    return 1
  fi

  prefer_rbenv_if_present

  if ! command -v apt-get >/dev/null 2>&1; then
    echo "[run] ERROR: ruby-upgrade only automates Ubuntu (apt-get). On macOS use Homebrew/rbenv; see README."
    return 1
  fi

  echo "[run] ruby-upgrade: installing Ruby ${RBENV_RUBY_VERSION} via rbenv + bundler + gems..."
  if ! auto_fix_ruby; then
    echo "[run] ERROR: ruby-upgrade failed (rbenv / build deps). See messages above."
    return 1
  fi

  ensure_bundler
  echo "[run] installing gems (bundle install)..."
  bundle install

  ruby_check_diagnostics
  echo "[run] ruby-upgrade: done"
  install_rbenv_into_bashrc || true
  return 0
}

cmd_shell_init() {
  install_rbenv_into_bashrc
}

cmd_run() {
  shift
  if [ "${1:-}" = "--" ]; then
    shift
  fi
  if [ "$#" -eq 0 ]; then
    echo "[run] ERROR: missing command. Example:"
    echo "  ./optools run -- bundle exec ruby tools/check_liquid_posts.rb"
    exit 2
  fi
  prefer_rbenv_if_present
  exec "$@"
}

check_env() {
  echo "[run] checking environment..."
  prefer_rbenv_if_present
  ruby_check_diagnostics

  if ! command -v ruby >/dev/null 2>&1; then
    echo "[run] ERROR: ruby not found in PATH"
    return 1
  fi

  RUBY_VERSION="$(ruby -e 'print RUBY_VERSION')"
  if ! printf '%s\n%s\n' "$MIN_RUBY_VERSION" "$RUBY_VERSION" | sort -V -C; then
    if auto_fix_ruby; then
      RUBY_VERSION="$(ruby -e 'print RUBY_VERSION')"
    else
      cat <<'EOF'
[run] ERROR: Ruby version too old for Chirpy/Jekyll 4.3

Chirpy requires Ruby >= 3.1 and Jekyll ~> 4.3.

Auto-fix was skipped/failed. To try auto-fix, ensure this script can:
  - run apt-get (root or sudo)
  - access github.com (git clone)

On Ubuntu, run explicitly:
  AUTO_FIX=1 ./optools ruby-upgrade

Manual fix (Ubuntu, using rbenv):
  sudo apt update
  sudo apt install -y git build-essential autoconf bison libssl-dev libreadline-dev zlib1g-dev libyaml-dev libffi-dev libgdbm-dev libncurses-dev
  git clone https://github.com/rbenv/rbenv.git ~/.rbenv
  git clone https://github.com/rbenv/ruby-build.git ~/.rbenv/plugins/ruby-build
  export PATH="$HOME/.rbenv/bin:$PATH"
  eval "$(rbenv init - bash)"
  rbenv install 3.2.3
  rbenv local 3.2.3
  gem install bundler
  bundle install

Then re-run:
  ./optools check
EOF
      echo "[run] current ruby: ${RUBY_VERSION}"
      return 1
    fi
  fi

  ensure_bundler

  echo "[run] ruby: ${RUBY_VERSION}"
  echo "[run] bundler: $(bundle -v)"

  if ! bundle check >/dev/null 2>&1; then
    echo "[run] installing gems (bundle install)..."
    bundle install
  fi

  echo "[run] environment OK"
  return 0
}

start_jekyll() {
  local -a jekyll_args
  jekyll_args=(serve)

  if [ "${DEBUG}" = "1" ]; then
    jekyll_args+=(--trace)
  fi

  {
    echo "================================================================"
    echo "[run] $(date '+%Y-%m-%d %H:%M:%S') starting jekyll"
    echo "[run] pwd: $(pwd)"
    echo "[run] ruby: $(ruby -e 'print RUBY_VERSION')"
    echo "[run] bundler: $(bundle -v)"
    echo "[run] cmd: bundle exec jekyll ${jekyll_args[*]}"
    echo "================================================================"
  } >> "${LOG_FILE}"

  # Run in background, keep stdout+stderr in one file, and record PID.
  (bundle exec jekyll "${jekyll_args[@]}" >> "${LOG_FILE}" 2>&1) &
  echo "$!" > "${PID_FILE}"

  # If it exits shortly after start, show some logs to help debugging.
  # Some failures happen after the initial boot, so we watch for a few seconds.
  local pid
  pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
  local i
  for i in $(seq 1 10); do
    if [ -z "${pid}" ] || ! kill -0 "${pid}" >/dev/null 2>&1; then
      echo "[run] ERROR: jekyll exited shortly after start. Showing recent logs:"
      echo "[run] ---- last 200 lines of ${LOG_FILE} ----"
      tail -n 200 "${LOG_FILE}" || true
      echo "[run] ---- error hints (from last 400 lines) ----"
      tail -n 400 "${LOG_FILE}" 2>/dev/null | grep -nE "Liquid Exception|Error:|FATAL|fatal|No such file|could not locate|Missing|undefined method|Invalid|Permission denied|Configuration file:|Dependency Error" -C 2 || true
      echo "[run] ----"
      echo "[run] For full stack trace, run:  DEBUG=1 ./optools start   (then see run.log)"
      rm -f "${PID_FILE}" || true
      return 1
    fi
    sleep 1
  done

  echo "[run] done. pid=$(cat "${PID_FILE}")"
  return 0
}

auto_fix_ruby() {
  if [ "$AUTO_FIX" != "1" ]; then
    return 1
  fi

  if ! command -v apt-get >/dev/null 2>&1; then
    echo "[run] auto-fix skipped: apt-get not found"
    return 1
  fi

  echo "[run] attempting auto-fix: install Ruby via rbenv (target ${RBENV_RUBY_VERSION})"

  maybe_sudo apt-get update
  maybe_sudo apt-get install -y \
    build-essential \
    git \
    autoconf \
    bison \
    libssl-dev \
    libreadline-dev \
    zlib1g-dev \
    libyaml-dev \
    libffi-dev \
    libgdbm-dev \
    libncurses-dev

  if ! command -v git >/dev/null 2>&1; then
    echo "[run] auto-fix failed: git not available (apt install git?)"
    return 1
  fi

  export RBENV_ROOT="${RBENV_ROOT:-$HOME/.rbenv}"
  if [ ! -d "$RBENV_ROOT" ]; then
    run_cmd git clone https://github.com/rbenv/rbenv.git "$RBENV_ROOT"
  fi
  if [ ! -d "$RBENV_ROOT/plugins/ruby-build" ]; then
    run_cmd git clone https://github.com/rbenv/ruby-build.git "$RBENV_ROOT/plugins/ruby-build"
  fi

  if ! ensure_rbenv_loaded; then
    echo "[run] auto-fix failed: rbenv not available after install"
    return 1
  fi

  if ! rbenv versions --bare | grep -qx "${RBENV_RUBY_VERSION}"; then
    run_cmd rbenv install "${RBENV_RUBY_VERSION}"
  fi

  # Prefer project-local Ruby version so future runs are consistent.
  run_cmd rbenv local "${RBENV_RUBY_VERSION}"
  run_cmd rbenv rehash

  echo "[run] ruby after auto-fix: $(ruby -e 'print RUBY_VERSION')"
  return 0
}

case "$COMMAND" in
  "")
    usage
    exit 0
    ;;
  start)
    echo "[run] starting..."
    stop_jekyll
    check_env
    echo "[run] launching jekyll (logs: ${LOG_FILE})"
    start_jekyll
    ;;
  stop)
    stop_jekyll
    echo "[run] done."
    ;;
  restart)
    stop_jekyll
    "$0" start
    ;;
  status)
    status_jekyll
    ;;
  check)
    check_env
    ;;
  ruby-check)
    cmd_ruby_check
    ;;
  ruby-upgrade)
    cmd_ruby_upgrade
    ;;
  shell-init)
    cmd_shell_init
    ;;
  run)
    cmd_run "$@"
    ;;
  liquid-check)
    prefer_rbenv_if_present
    echo "[run] bundle exec ruby tools/check_liquid_posts.rb ${*:2}"
    bundle exec ruby tools/check_liquid_posts.rb "${@:2}"
    ;;
  bundle-content-css)
    run_cmd bash "${REPO_ROOT}/tools/bundle-post-content-css.sh"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "[run] ERROR: unknown command: ${COMMAND}"
    usage
    exit 2
    ;;
esac
