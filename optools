#!/bin/bash

set -euo pipefail

LOG_FILE="${LOG_FILE:-run.log}"
PID_FILE="${PID_FILE:-.jekyll.pid}"
MIN_RUBY_VERSION="${MIN_RUBY_VERSION:-3.1.0}"
AUTO_FIX="${AUTO_FIX:-1}"
RBENV_RUBY_VERSION="${RBENV_RUBY_VERSION:-3.2.3}"
DEBUG="${DEBUG:-0}"

COMMAND="${1:-}"
APP_NAME="${APP_NAME:-jekyll}"

usage() {
  cat <<'EOF'
Usage:
  ./optools start       Start Jekyll in background
  ./optools stop        Stop running Jekyll processes
  ./optools restart     Stop then start
  ./optools status      Show whether Jekyll is running
  ./optools check       Check Ruby/Bundler/Gems readiness (no start)
  ./optools help        Show this help

Env:
  LOG_FILE=run.log              Output log file
  PID_FILE=.jekyll.pid          PID file for the background process
  MIN_RUBY_VERSION=3.1.0        Minimum Ruby version
  AUTO_FIX=1                    Auto-fix Ruby via rbenv (Ubuntu) when too old
  RBENV_RUBY_VERSION=3.2.3      Ruby version to install via rbenv
  DEBUG=0                       Set to 1 to add jekyll --trace output
EOF
}

run_cmd() {
  echo "[run] $*"
  "$@"
}

maybe_sudo() {
  if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    "$@"
  else
    sudo "$@"
  fi
}

stop_jekyll() {
  if [ -f "${PID_FILE}" ]; then
    local pid
    pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    if [ -n "${pid}" ] && kill -0 "${pid}" >/dev/null 2>&1; then
      echo "[run] stopping ${APP_NAME} (pid ${pid})..."
      kill "${pid}" || true
      sleep 1
      if kill -0 "${pid}" >/dev/null 2>&1; then
        echo "[run] WARNING: still running, forcing stop..."
        kill -9 "${pid}" || true
      fi
      rm -f "${PID_FILE}" || true
      return 0
    fi
    rm -f "${PID_FILE}" || true
  fi

  if pgrep -f "jekyll serve" >/dev/null 2>&1; then
    echo "[run] stopping ${APP_NAME}..."
    pkill -f "jekyll serve" || true
    sleep 1
  fi

  if pgrep -f "jekyll serve" >/dev/null 2>&1; then
    echo "[run] WARNING: still running, forcing stop..."
    pkill -9 -f "jekyll serve" || true
  fi
}

status_jekyll() {
  if [ -f "${PID_FILE}" ]; then
    local pid
    pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    if [ -n "${pid}" ] && kill -0 "${pid}" >/dev/null 2>&1; then
      echo "[run] status: running (pid ${pid})"
      return 0
    fi
  fi

  if pgrep -f "jekyll serve" >/dev/null 2>&1; then
    echo "[run] status: running"
    pgrep -af "jekyll serve" || true
    return 0
  fi
  echo "[run] status: stopped"
  return 1
}

ensure_rbenv_loaded() {
  export RBENV_ROOT="${RBENV_ROOT:-$HOME/.rbenv}"
  export PATH="$RBENV_ROOT/bin:$PATH"

  if command -v rbenv >/dev/null 2>&1; then
    # shellcheck disable=SC1090
    eval "$(rbenv init - bash)"
    return 0
  fi

  return 1
}

check_env() {
  echo "[run] checking environment..."

  if ! command -v ruby >/dev/null 2>&1; then
    echo "[run] ERROR: ruby not found in PATH"
    return 1
  fi

  RUBY_VERSION="$(ruby -e 'print RUBY_VERSION')"
  if ! printf '%s\n%s\n' "$MIN_RUBY_VERSION" "$RUBY_VERSION" | sort -V -C; then
    if auto_fix_ruby; then
      RUBY_VERSION="$(ruby -e 'print RUBY_VERSION')"
    else
      cat <<'EOF'
[run] ERROR: Ruby version too old for Chirpy/Jekyll 4.3

Chirpy requires Ruby >= 3.1 and Jekyll ~> 4.3.

Auto-fix was skipped/failed. To try auto-fix, ensure this script can:
  - run apt-get (root or sudo)
  - access github.com (git clone)

Manual fix (Ubuntu, using rbenv):
  sudo apt update
  sudo apt install -y git build-essential libssl-dev libreadline-dev zlib1g-dev libyaml-dev libffi-dev
  git clone https://github.com/rbenv/rbenv.git ~/.rbenv
  git clone https://github.com/rbenv/ruby-build.git ~/.rbenv/plugins/ruby-build
  export PATH="$HOME/.rbenv/bin:$PATH"
  eval "$(rbenv init - bash)"
  rbenv install 3.2.3
  rbenv local 3.2.3
  gem install bundler
  bundle install

Then re-run:
  ./optools
EOF
      echo "[run] current ruby: ${RUBY_VERSION}"
      return 1
    fi
  fi

  if ! command -v bundle >/dev/null 2>&1; then
    echo "[run] bundler not found; installing..."
    gem install bundler --no-document
  fi

  echo "[run] ruby: ${RUBY_VERSION}"
  echo "[run] bundler: $(bundle -v)"

  if ! bundle check >/dev/null 2>&1; then
    echo "[run] installing gems (bundle install)..."
    bundle install
  fi

  echo "[run] environment OK"
  return 0
}

start_jekyll() {
  local -a jekyll_args
  jekyll_args=(serve)

  if [ "${DEBUG}" = "1" ]; then
    jekyll_args+=(--trace)
  fi

  {
    echo "================================================================"
    echo "[run] $(date '+%Y-%m-%d %H:%M:%S') starting jekyll"
    echo "[run] pwd: $(pwd)"
    echo "[run] ruby: $(ruby -e 'print RUBY_VERSION')"
    echo "[run] bundler: $(bundle -v)"
    echo "[run] cmd: bundle exec jekyll ${jekyll_args[*]}"
    echo "================================================================"
  } >> "${LOG_FILE}"

  # Run in background, keep stdout+stderr in one file, and record PID.
  (bundle exec jekyll "${jekyll_args[@]}" >> "${LOG_FILE}" 2>&1) &
  echo "$!" > "${PID_FILE}"

  # If it exits immediately, show some logs to help debugging.
  sleep 2
  if ! kill -0 "$(cat "${PID_FILE}" 2>/dev/null)" >/dev/null 2>&1; then
    echo "[run] ERROR: jekyll exited shortly after start. Showing recent logs:"
    echo "[run] ---- last 200 lines of ${LOG_FILE} ----"
    tail -n 200 "${LOG_FILE}" || true
    echo "[run] ---- error hints (from last 400 lines) ----"
    tail -n 400 "${LOG_FILE}" 2>/dev/null | grep -nE "Liquid Exception|Error:|FATAL|fatal|No such file|could not locate|Missing|undefined method|Invalid|Permission denied" -C 2 || true
    rm -f "${PID_FILE}" || true
    return 1
  fi

  echo "[run] done. pid=$(cat "${PID_FILE}")"
  return 0
}

auto_fix_ruby() {
  if [ "$AUTO_FIX" != "1" ]; then
    return 1
  fi

  if ! command -v apt-get >/dev/null 2>&1; then
    echo "[run] auto-fix skipped: apt-get not found"
    return 1
  fi

  if ! command -v git >/dev/null 2>&1; then
    echo "[run] auto-fix skipped: git not found"
    return 1
  fi

  echo "[run] attempting auto-fix: install Ruby via rbenv (target ${RBENV_RUBY_VERSION})"

  maybe_sudo apt-get update
  maybe_sudo apt-get install -y \
    build-essential \
    libssl-dev \
    libreadline-dev \
    zlib1g-dev \
    libyaml-dev \
    libffi-dev

  export RBENV_ROOT="${RBENV_ROOT:-$HOME/.rbenv}"
  if [ ! -d "$RBENV_ROOT" ]; then
    run_cmd git clone https://github.com/rbenv/rbenv.git "$RBENV_ROOT"
  fi
  if [ ! -d "$RBENV_ROOT/plugins/ruby-build" ]; then
    run_cmd git clone https://github.com/rbenv/ruby-build.git "$RBENV_ROOT/plugins/ruby-build"
  fi

  if ! ensure_rbenv_loaded; then
    echo "[run] auto-fix failed: rbenv not available after install"
    return 1
  fi

  if ! rbenv versions --bare | grep -qx "${RBENV_RUBY_VERSION}"; then
    run_cmd rbenv install "${RBENV_RUBY_VERSION}"
  fi

  # Prefer project-local Ruby version so future runs are consistent.
  run_cmd rbenv local "${RBENV_RUBY_VERSION}"
  run_cmd rbenv rehash

  echo "[run] ruby after auto-fix: $(ruby -e 'print RUBY_VERSION')"
  return 0
}

case "$COMMAND" in
  "")
    usage
    exit 0
    ;;
  start)
    echo "[run] starting..."
    stop_jekyll
    check_env
    echo "[run] launching jekyll (logs: ${LOG_FILE})"
    start_jekyll
    ;;
  stop)
    stop_jekyll
    echo "[run] done."
    ;;
  restart)
    stop_jekyll
    "$0" start
    ;;
  status)
    status_jekyll
    ;;
  check)
    check_env
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "[run] ERROR: unknown command: ${COMMAND}"
    usage
    exit 2
    ;;
esac
