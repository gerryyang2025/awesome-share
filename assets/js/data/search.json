---
# Overrides Chirpy theme `assets/js/data/search.json` (theme uses layout: compress + post-summary include).
# This file reproduces the former repo-root `search.json.html` generator byte-for-byte in behavior:
# same URL `/assets/js/data/search.json`, same fields expected by `assets/js/blog-search.js`:
# title, url, categories, tags, date, content (plain text, truncate 5000, rouge lineno stripped).
layout: null
permalink: /assets/js/data/search.json
---
[
{% for post in site.posts %}
{% assign c = post.content %}
{% if c contains '<td class="rouge-gutter gl"><pre class="lineno">' %}
{% assign c = c
  | replace: '<td class="rouge-gutter gl"><pre class="lineno">', '<!-- <td class="rouge-gutter gl"><pre class="lineno">'
%}
{% assign c = c | replace: '</td><td class="rouge-code">', '</td> --><td class="rouge-code">' %}
{% endif %}
{% assign c = c | strip_html | strip_newlines | strip | truncate: 5000 %}
{
  "title": {{ post.title | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "categories": {{ post.categories | join: ', ' | jsonify }},
  "tags": {{ post.tags | join: ', ' | jsonify }},
  "date": {{ post.date | jsonify }},
  "content": {{ c | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
